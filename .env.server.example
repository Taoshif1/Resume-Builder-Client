# Local API. npm run server:dev and npm run dev:full load this file with Node 22.
PORT=3000
APP_ORIGIN=http://localhost:5173
FIREBASE_PROJECT_ID=
# Complete JSON on one line; never use a VITE_ prefix for credentials.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternative local credential source (private file outside the repository):
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Production Vercel runtime also requires:
# APP_ORIGIN=https://personacv.vercel.app
# FIREBASE_PROJECT_ID=<same project as VITE_projectId>
# FIREBASE_SERVICE_ACCOUNT_JSON=<complete service account JSON>
# Optional server-only features:
# OWNER_BOOTSTRAP_UID=
# AI_API_KEY=
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_MODEL=

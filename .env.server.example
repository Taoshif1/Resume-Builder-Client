NODE_ENV=production
PORT=3000
APP_ORIGIN=https://your-personacv-domain.example
FIREBASE_PROJECT_ID=
# Prefer an attached Google service identity / Application Default Credentials.
# Otherwise set GOOGLE_APPLICATION_CREDENTIALS to a PRIVATE file outside the repo,
# or supply FIREBASE_SERVICE_ACCOUNT_JSON through your hosting secret manager.
# GOOGLE_APPLICATION_CREDENTIALS=
# FIREBASE_SERVICE_ACCOUNT_JSON=
# One-time bootstrap only; remove after running npm run bootstrap:owner.
# OWNER_BOOTSTRAP_UID=
# Optional OpenAI-compatible writing provider. All three are server-only.
# AI_API_KEY=
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_MODEL=
# Future billing adapter credentials (unused until an adapter is implemented).
# BILLING_SECRET_KEY=
# BILLING_WEBHOOK_SECRET=
# BILLING_PRO_PRICE_ID=
